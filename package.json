{
  "name": "sweep-node-modules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sweep-nm": "bin/sweep-nm"
  },
  "scripts": {
    "prepare": "[ -z \"$CI\" ] && lefthook install || true",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "test": "bun test",
    "bench": "bun bench/run.ts",
    "conformance": "bun scripts/transcription/run-conformance.ts"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.14",
    "oxlint": "1.85.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
