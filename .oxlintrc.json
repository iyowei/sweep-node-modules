{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "promise", "node", "unicorn"],
  "categories": {},
  "rules": {
    "no-useless-concat": "deny",
    "no-unused-vars": "deny",
    "no-await-in-loop": "allow",
    "no-bitwise": "deny",
    "no-plusplus": "deny",
    "no-undefined": "allow",
    "max-depth": ["deny", { "max": 4 }],
    "max-lines": [
      "deny",
      { "max": 450, "skipBlankLines": true, "skipComments": true }
    ],
    "max-lines-per-function": [
      "deny",
      { "max": 200, "skipBlankLines": true, "skipComments": true }
    ],
    "max-nested-callbacks": ["deny", { "max": 3 }],
    "max-params": ["deny", { "max": 6 }],
    "max-classes-per-file": ["deny", { "max": 1 }],
    "oxc/no-accumulating-spread": "deny",
    "import/no-cycle": "deny",
    "import/no-duplicates": "deny",
    "import/named": "deny",
    "import/no-mutable-exports": "deny",
    "unicorn/prefer-set-has": "deny",
    "unicorn/no-anonymous-default-export": "deny",
    "unicorn/no-array-for-each": "deny",
    "unicorn/no-nested-ternary": "deny",
    "unicorn/prefer-node-protocol": "deny",
    "promise/catch-or-return": "deny",
    "promise/no-nesting": "deny",
    "promise/prefer-await-to-then": "allow"
  },
  "env": { "builtin": true, "node": true },
  "globals": {
    "console": "readonly",
    "process": "readonly",
    "Bun": "readonly",
    "setTimeout": "readonly",
    "clearTimeout": "readonly"
  },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
