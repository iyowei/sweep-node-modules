{
  // 发布构建: 仅编译运行时核心模块, 产物供 npm 包使用。
  // 存在的理由: node 拒绝对 node_modules 内的 TypeScript 做类型剥离
  // (ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING), 故 npm 分发必须是编译后的 JS,
  // 否则「装任一运行时即可用」在 node 侧失效。仓库内开发仍直跑 TS, 不经此配置。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    // 源码 import 带 .ts 扩展名 (node 直跑 TS 的硬要求), 产物须改写为 .js 才能在 node 下解析
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src"],
  // 冒烟入口逐个点名而非用 *.smoke.ts glob: TS 7 的该 glob 漏匹配 runtime.node-smoke.ts
  // (实测其仍被 include 纳入), 逐条列出才是可靠判据
  "exclude": [
    "src/**/*.test.ts",
    "src/init.smoke.ts",
    "src/runtime.node-smoke.ts",
    "src/fixtures.ts",
    "src/render.fixtures.ts",
    "src/golden.ts"
  ]
}
