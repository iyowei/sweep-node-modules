{
  "id": "scan-exclude-config",
  "specRefs": ["BC-03", "OF-03"],
  "fixture": {
    "projects": [{ "dir": "zone/skipme/proj" }, { "dir": "zone/keep" }]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"roots\": [\"$FIXTURE/zone\"],\n  \"exclude\": [\"skipme\"]\n}\n"
      }
    }
  ],
  "run": {
    "env": { "SWEEP_NM_CONFIG": "$FIXTURE/config.json" }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP-NM  预览 · 1 个根: $FIXTURE/zone\n  ▒ 8 KB  keep    $FIXTURE/zone/keep\n  █ 合计 1 处 · 8 KB   加 --yes 执行删除\n",
    "stdoutMustNotContain": ["skipme", "proj"]
  }
}
