  "fixture": {
    "projects": [{ "dir": "zone/我的项目" }, { "dir": "zone/短" }]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"roots\": [\"$FIXTURE/zone\"],\n  \"exclude\": []\n}\n"
      }
    }
