{
  "compilerOptions": {
    // bun / node 均可直跑 TS, 目标取保守基线
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["bun"]
  },
  "include": ["src", "bench", "scripts"],
  // 变异生成器的产物 (gen-*/src/*.ts) 由 make-mutants.ts 生成, 是派生件而非源码;
  // 不排除则重跑生成器后 tsc --noEmit 会把它们收进编译范围并变红 (实测命中)
  "exclude": ["scripts/transcription/mutants"]
}
